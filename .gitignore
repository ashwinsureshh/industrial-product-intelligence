# dependencies
node_modules/
__pycache__/
*.py[cod]
venv/
.venv/

# build output
dist/
build/
*.egg-info/

# runtime
backend/.cache/
*.log

# secrets — the app never needs a committed key, and must never carry one
.env
.env.local

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# local-only tool state (launch.json is shared, settings.local.json is not)
.claude/settings.local.json

# benchmark run lock (runtime only)
backend/.benchmark.lock

# learned taxonomy state (runtime; the repo ships the curated base only)
backend/app/data/learned_categories.json
backend/app/data/proposals.json

# Skill definitions pulled in by the agent runtime, not project source.
.claude/skills/

# build_deck.py's working copy and preview scratch. The deliverable is
# docs/UniHack_Prototype_Submission.pptx, which the script copies up.
docs/deck/UniHack_Prototype_Submission.pptx
docs/deck/*_preview.png
docs/deck/_preview.html

# Draft demo footage. The recorder and the script are tracked; the 9 MB webm is
# a rebuildable intermediate, and the submitted video lives on YouTube.
docs/video/footage/

# PowerPoint lock files, present while the deck is open in the app.
~$*
