# Every setting here is optional. With no .env file at all the app runs in demo
# mode: fully functional, deterministic, and free.

# Your own key, for local development in live mode. Never commit a real key.
# ANTHROPIC_API_KEY=sk-ant-...

# Let requests that supply no key fall back to the server's key above.
# Leave this off for any hosted or submitted instance, otherwise visitors
# spend your credits.
# PI_ALLOW_SERVER_KEY=1

# Hard-disable live mode. Set this on a public demo to guarantee that no
# request can ever trigger a paid API call.
# PI_ALLOW_LIVE=0

# Model used in live mode.
# PI_MODEL=claude-sonnet-5

# Disable the result cache (on by default — identical inputs never pay twice).
# PI_CACHE=0
