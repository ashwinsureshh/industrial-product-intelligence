{
  "source": "provisional",
  "replaces_with": "Unilog_Master_UOM_Standards_Abbreviations_and_Terms.xlsx",
  "note": "Stand-in for the ~500-row / 89-measurement-type approved list. Every abbreviation here is the form used in the organizers' own worked example or the common trade form; when their sheet arrives, regenerate this file and set source to 'unilog'. Loaders surface the source so nothing claims verified compliance on a stub.",
  "rules": {
    "space_between_number_and_unit": true,
    "compact_forms_allowed_in": ["invoice_desc"]
  },
  "units": [
    {"measurement": "Length", "abbreviation": "in", "accepts": ["in", "in.", "inch", "inches", "\"", "''"]},
    {"measurement": "Length", "abbreviation": "ft", "accepts": ["ft", "ft.", "foot", "feet", "'"]},
    {"measurement": "Length", "abbreviation": "mm", "accepts": ["mm", "millimeter", "millimeters", "millimetre", "millimetres"]},
    {"measurement": "Length", "abbreviation": "cm", "accepts": ["cm", "centimeter", "centimeters"]},
    {"measurement": "Length", "abbreviation": "m", "accepts": ["m", "meter", "meters", "metre", "metres"]},
    {"measurement": "Weight", "abbreviation": "lb", "accepts": ["lb", "lbs", "lb.", "pound", "pounds"]},
    {"measurement": "Weight", "abbreviation": "oz", "accepts": ["oz", "ounce", "ounces"]},
    {"measurement": "Weight", "abbreviation": "kg", "accepts": ["kg", "kilogram", "kilograms"]},
    {"measurement": "Weight", "abbreviation": "g", "accepts": ["g", "gram", "grams"]},
    {"measurement": "Voltage", "abbreviation": "V", "accepts": ["v", "volt", "volts", "vac", "vdc"]},
    {"measurement": "Current", "abbreviation": "A", "accepts": ["a", "amp", "amps", "ampere", "amperes"]},
    {"measurement": "Current", "abbreviation": "mA", "accepts": ["ma", "milliamp", "milliamps"]},
    {"measurement": "Power", "abbreviation": "W", "accepts": ["w", "watt", "watts"]},
    {"measurement": "Power", "abbreviation": "kW", "accepts": ["kw", "kilowatt", "kilowatts"]},
    {"measurement": "Power", "abbreviation": "HP", "accepts": ["hp", "horsepower"]},
    {"measurement": "Frequency", "abbreviation": "Hz", "accepts": ["hz", "hertz"]},
    {"measurement": "Noise", "abbreviation": "dBA", "accepts": ["dba", "db(a)", "decibel", "decibels", "db"]},
    {"measurement": "Pressure", "abbreviation": "psi", "accepts": ["psi", "psig", "lbs/sq in", "pound per square inch"]},
    {"measurement": "Pressure", "abbreviation": "bar", "accepts": ["bar", "bars"]},
    {"measurement": "Pressure", "abbreviation": "kPa", "accepts": ["kpa", "kilopascal", "kilopascals"]},
    {"measurement": "Pressure", "abbreviation": "MPa", "accepts": ["mpa", "megapascal", "megapascals"]},
    {"measurement": "Tensile Strength", "abbreviation": "ksi", "accepts": ["ksi"]},
    {"measurement": "Flow Rate", "abbreviation": "gpm", "accepts": ["gpm", "gal/min", "gallons per minute"]},
    {"measurement": "Flow Rate", "abbreviation": "L/min", "accepts": ["l/min", "lpm", "liters per minute", "litres per minute"]},
    {"measurement": "Flow Rate", "abbreviation": "cfm", "accepts": ["cfm", "cu ft/min", "cubic feet per minute"]},
    {"measurement": "Temperature", "abbreviation": "deg F", "accepts": ["f", "°f", "degf", "deg f", "fahrenheit"]},
    {"measurement": "Temperature", "abbreviation": "deg C", "accepts": ["c", "°c", "degc", "deg c", "celsius", "centigrade"]},
    {"measurement": "Rotational Speed", "abbreviation": "rpm", "accepts": ["rpm", "r/min", "min-1", "revolutions per minute"]},
    {"measurement": "Force", "abbreviation": "lbf", "accepts": ["lbf", "pound-force"]},
    {"measurement": "Force", "abbreviation": "kN", "accepts": ["kn", "kilonewton", "kilonewtons"]},
    {"measurement": "Force", "abbreviation": "N", "accepts": ["n", "newton", "newtons"]},
    {"measurement": "Torque", "abbreviation": "in-lb", "accepts": ["in-lb", "in lb", "inch-pound", "inch pounds"]},
    {"measurement": "Torque", "abbreviation": "ft-lb", "accepts": ["ft-lb", "ft lb", "foot-pound", "foot pounds"]},
    {"measurement": "Torque", "abbreviation": "Nm", "accepts": ["nm", "n-m", "newton meter", "newton metre"]},
    {"measurement": "Angle", "abbreviation": "deg", "accepts": ["deg", "°", "degree", "degrees"]},
    {"measurement": "Volume", "abbreviation": "gal", "accepts": ["gal", "gallon", "gallons"]},
    {"measurement": "Volume", "abbreviation": "L", "accepts": ["l", "liter", "liters", "litre", "litres"]},
    {"measurement": "Capacity", "abbreviation": "cu ft", "accepts": ["cu ft", "cuft", "ft3", "cubic feet", "cubic foot"]},
    {"measurement": "Time", "abbreviation": "ms", "accepts": ["ms", "millisecond", "milliseconds"]},
    {"measurement": "Time", "abbreviation": "sec", "accepts": ["s", "sec", "second", "seconds"]},
    {"measurement": "Time", "abbreviation": "min", "accepts": ["min", "minute", "minutes"]},
    {"measurement": "Time", "abbreviation": "hr", "accepts": ["h", "hr", "hour", "hours"]},
    {"measurement": "Thread Count", "abbreviation": "TPI", "accepts": ["tpi", "threads per inch"]},
    {"measurement": "Gauge", "abbreviation": "AWG", "accepts": ["awg", "american wire gauge"]},
    {"measurement": "Count", "abbreviation": "ea", "accepts": ["ea", "each", "pc", "pcs", "piece", "pieces"]}
  ]
}
