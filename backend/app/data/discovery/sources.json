{
  "source": "provisional",
  "replaces_with": "UniCat_Manufacturer_and_Brand_List.xlsx (27,000+ approved manufacturer/brand rows)",
  "note": "The brand -> official-domain registry is the whole basis for deciding whether a page is manufacturer-provided. Twelve entries here are a stand-in seeded from the brands in Unilog's own sample; their approved list replaces this file, not the code.",

  "policy": {
    "allow_unknown_domains": false,
    "allow_unknown_note": "A page can only be cited as manufacturer-provided if we can show the domain belongs to the manufacturer. Defaulting to open would let any blog or reseller become a source, and their brief bans non-manufacturer sourcing outright. Unknown domains are refused with a reason rather than fetched."
  },

  "blocked": [
