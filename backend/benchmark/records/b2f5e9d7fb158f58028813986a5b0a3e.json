 where users apply their own lubrication regimen or require periodic cleaning access, as opposed to shielded or sealed variants.\n\nNote: Bore Diameter and Outer Diameter values are listed as supplied (62 mm bore / 30 mm OD in source data); confirm dimensional orientation against SKF 6206 documentation before ordering, as standard 6206 bearings typically use a 30 mm bore and 62 mm OD.", "bullets": ["MPN: SKF 6206 - Single-row deep groove ball bearing, open seal type", "Bore: 30 mm / Outer Diameter: 62 mm / Width: 16 mm", "Ring Material: Chrome Steel (GCr15/52100); Cage Material: Steel", "Dynamic Load Rating (C): 19.5 kN / Static Load Rating (C0): 11.2 kN", "Limiting Speed: 13,000 rpm", "Max Operating Temperature: 120\u00b0C", "Precision Class: ABEC-1 / P0"], "meta_description": "SKF 6206 open deep groove ball bearing, 30mm bore, 62mm OD, 16mm width, chrome steel, 19.5kN dynamic load, 13000 rpm, ABEC-1.", "keywords": ["SKF 6206", "6206 bearing", "deep groove ball bearing", "open ball bearing", "chrome steel bearing", "ABEC-1 bearing", "30mm bore bearing", "62mm OD bearing"], "search_terms": ["SKF6206", "6206 open bearing", "6206-Z alternative open", "6206 ball bearing 30x62x16", "SKF 6206 bearing"]}, "issues": [{"code": "GEOMETRY_CONTRADICTION", "severity": "error", "field": "bore_diameter", "message": "Bore diameter (62.0 mm) is not smaller than outer diameter (30.0 mm).", "suggestion": "The two values are most likely transposed in the source data."}], "readiness": {"overall": 92.0, "completeness": 100.0, "confidence": 99.0, "validity": 78.0, "verdict": "blocked", "missing_required": [], "notes": ["1 blocking error(s) must be resolved before publication."]}, "trace": [{"stage": "normalize", "summary": "Cleaned input and resolved identity.", "duration_ms": 0, "added": ["mpn", "sku", "brand", "brand_country"], "changed": [], "details": {"identity": {"mpn": "6206", "sku": "3117-006", "brand": "SKF", "brand_country": "Sweden"}}}, {"stage": "classify", "summary": "Assign